# Placeholders only. Copy to .env (gitignored), edit it, and pass --env-file .env, or export the
# variables. Nothing reads .env unless --env-file is given.
# Only the SQL Server adapter reads these. The SQLite adapter takes a file path on the command line.

QG_DB_DRIVER=ODBC Driver 18 for SQL Server
QG_DB_HOST=localhost
QG_DB_PORT=1433
# Leave QG_DB_USER empty to use integrated authentication (Trusted_Connection).
QG_DB_USER=report_reader
QG_DB_PASSWORD=change-me
# Optional schema filter for introspection (empty = all schemas).
QG_DB_SCHEMA=
# yes only for local test servers with self-signed certificates.
QG_DB_TRUST_SERVER_CERT=no
# Character encoding the driver should use for CHAR/VARCHAR columns.
QG_DB_CHAR_ENCODING=utf-8
# READ UNCOMMITTED | READ COMMITTED | REPEATABLE READ | SNAPSHOT | SERIALIZABLE
QG_DB_ISOLATION=READ UNCOMMITTED
QG_DB_LOGIN_TIMEOUT=10
QG_DB_QUERY_TIMEOUT=120
